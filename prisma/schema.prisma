generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Url {
  id        String   @id @default(uuid())
  code      String
  url       String
  createdAt DateTime @default(now())

  @@unique([code, url])
  @@map("urls")
}
