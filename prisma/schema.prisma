generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Url {
  id        String   @id @default(uuid())
  code      String   @unique
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("urls")
}
