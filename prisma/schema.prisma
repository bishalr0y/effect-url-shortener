generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String @unique
  urls     Url[]

  @@map("users")
}

model Url {
  id        String   @id @default(uuid())
  userIdFk  String   @map("user_id_fk")
  user      User     @relation(fields: [userIdFk], references: [id], onDelete: Cascade)
  code      String   @unique
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("urls")
}
